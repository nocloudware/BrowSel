<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BrowSel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowSel"
    Title="BrowSel">

    <Grid x:Name="root" RowDefinitions="Auto,Auto,*" Background="Transparent">

        <!-- Own, draggable title bar, in the style of Windows Settings -->
        <Grid x:Name="titleBar" Height="48" Padding="16,0,12,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="titleText" Text="BrowSel" VerticalAlignment="Center" />
            <Button x:Name="btnSettings" Grid.Column="1" VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,0,16,12" Spacing="2">
            <TextBlock x:Name="txtPick" Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="txtUrl" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TreeView x:Name="tree" Grid.Row="2" Margin="4,0,4,8" SelectionChanged="OnSelectionChanged">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:Item">
                    <ContentPresenter Content="{x:Bind View}" HorizontalContentAlignment="Stretch" />
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock x:Name="empty" Grid.Row="2" Margin="16" Visibility="Collapsed" TextWrapping="Wrap"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Text is set from code: it follows the language -->
        <ContentDialog x:Name="dlgSettings" MinWidth="300">
            <StackPanel Spacing="16">
                <StackPanel x:Name="checks" Spacing="10" />
                <StackPanel Spacing="6">
                    <TextBlock x:Name="lblEditor" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="editorBox" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="lblLang" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="langBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnPreviewLang" />
                </StackPanel>
                <Button x:Name="btnUpdate" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="OnUpdateClick" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="dlgUpdate" PrimaryButtonText="" CloseButtonText="" />
    </Grid>
</Window>
