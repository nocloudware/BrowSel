<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BrowSel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowSel"
    Title="BrowSel">

    <Grid x:Name="root" RowDefinitions="Auto,Auto,*" Background="Transparent">

        <!-- Own, draggable title bar, in the style of Windows Settings -->
        <Grid x:Name="titleBar" Height="48" Padding="16,0,12,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
            <TextBlock x:Name="titleText" Text="BrowSel" VerticalAlignment="Center" />
            <Button x:Name="btnAbout" Grid.Column="1" VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0"
                    Click="OnAboutClick"
                    ToolTipService.ToolTip="About">
                <FontIcon Glyph="&#xE946;" FontSize="16" />
            </Button>
            <Button x:Name="btnDonate" Grid.Column="2" VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0"
                    Click="OnDonateClick"
                    ToolTipService.ToolTip="Donate">
                <FontIcon Glyph="&#xEB51;" FontSize="16" />
            </Button>
            <Button x:Name="btnSettings" Grid.Column="3" VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,0,16,12" Spacing="2">
            <TextBlock x:Name="txtPick" Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="txtUrl" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TreeView x:Name="tree" Grid.Row="2" Margin="4,0,4,8" SelectionChanged="OnSelectionChanged">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:Item">
                    <ContentPresenter Content="{x:Bind View}" HorizontalContentAlignment="Stretch" />
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock x:Name="empty" Grid.Row="2" Margin="16" Visibility="Collapsed" TextWrapping="Wrap"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Text is set from code: it follows the language -->
        <ContentDialog x:Name="dlgSettings" MinWidth="300">
            <StackPanel Spacing="16">
                <StackPanel x:Name="checks" Spacing="10" />
                <StackPanel Spacing="6">
                    <TextBlock x:Name="lblEditor" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="editorBox" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="lblLang" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="langBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnPreviewLang" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- The credits. A dialog and not a second window: a WinUI window is invisible until it is
             activated, and it needs hand made modality on top of that. A dialog needs neither. -->
        <ContentDialog x:Name="dlgAbout" MinWidth="400">
            <StackPanel Spacing="16">
                <!-- Logo, app name and version, with the update check beside the version -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Image x:Name="imgIcon" Width="48" Height="48" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="BrowSel" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="lblVersion" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="btnUpdate" Click="OnUpdateClick" FontSize="12"
                                    Padding="12,4" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="credits" Spacing="14" />
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
